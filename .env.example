# --- Fonte de dados: "local" lê data/*.json; "supabase" lê o banco ---
DADOS=local

# --- Supabase (Project Settings > API) ---
SUPABASE_URL=https://SEU-PROJETO.supabase.co
# chave "service_role": é secreta, nunca coloque no GitHub nem no navegador
SUPABASE_SERVICE_ROLE_KEY=

# --- Acesso durante os testes ---
# Com SENHA_ACESSO, o navegador pede usuário e senha (qualquer usuário; a senha é esta).
SENHA_ACESSO=
# Com LOGIN_DESATIVADO=1 e sem SENHA_ACESSO, o app abre para qualquer pessoa com o endereço.
LOGIN_DESATIVADO=1

# --- Login com Google (para depois dos testes: deixe as duas variáveis acima vazias) ---
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# e-mails autorizados, separados por vírgula
EMAILS_AUTORIZADOS=
