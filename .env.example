# --- Fonte de dados: "local" lê data/*.json; "sheets" lê a planilha Google ---
DADOS=local

# --- Google Sheets (conta de serviço) ---
GOOGLE_SHEETS_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=

# --- Login com Google ---
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# e-mails autorizados, separados por vírgula
EMAILS_AUTORIZADOS=

# Só para testar no próprio computador, sem login. Nunca use em produção.
LOGIN_DESATIVADO=1
